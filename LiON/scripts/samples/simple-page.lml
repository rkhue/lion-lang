<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
@@ lmout [title]
    </title>
    <style>
        body {
            font-family: system-ui, sans-serif;
            line-height: 1.5;
            margin: 0 auto;
            max-width: 40rem;
            padding: 3rem 1.5rem;
        }

        h1 {
            margin-bottom: 0.5rem;
        }

        .muted {
            color: #666;
        }
    </style>
</head>
<body>
    <main>
        <h1>
@@ lmout [heading]
        </h1>
        <p>
@@ lmout [message]
        </p>
        <p class="muted">Generated by LML in
@@ lmout [year]
        .</p>
    </main>
</body>
</html>