# Helper stuff

function display (thing) {
    info ["reg." + ?thing + ".__rel__"]
}

function get_std {
    import from @std (
        utils.py,
        strman.py,
        lorem.py,
        lmath.py,
        rand.py
    )

    lion @std/construtil.lion -> (silent:on)
    lion @std/ps.lion -> (silent:on)
}

function notice {
    echo [__notice__] "\n*"
    echo [version]
}

# Benchmarking
lion @scripts/benchmark.lion -> (silent:on)

# Greetings
notice